# ---------------------------------------------------------------------------
# Dhwani API configuration. Copy to server/.env and fill in.
# Every integration is optional: each one switches on when its keys are set,
# and GET /api/integrations (Settings > Integrations) shows what is live.
# ---------------------------------------------------------------------------

PORT=8787
# Comma separated dashboard origins in production, * while developing.
CORS_ORIGINS=*

# Public HTTPS URL of this API (Render/Railway URL, or a tunnel while developing).
# Bolna calls the booking tools and the webhook here; it cannot reach localhost.
PUBLIC_URL=

# --- Dashboard login ------------------------------------------------------
# Set before the API is reachable from the internet. Empty = no login.
ADMIN_PASSWORD=
# Optional; defaults to ADMIN_PASSWORD. Changing it signs everyone out.
AUTH_SECRET=

# --- Storage: Google Sheets ------------------------------------------------
# 1. Create a Google Cloud service account and download its JSON key.
# 2. Share the spreadsheet with the service account's email as Editor.
# 3. Paste the whole JSON on one line (or base64 of it), and the sheet id from its URL.
# Tabs and headers are created automatically. Without these, data goes to server/.data/db.json.
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Re-read the sheet this often, so edits made in Google Sheets reach the agent.
SHEETS_REFRESH_SEC=60
# true = fill an empty sheet with 25 sample calls and a week of appointments.
SEED_DEMO_DATA=false

# --- Phone agent: Bolna (Sarvam speech + Gemini) --------------------------
BOLNA_API_KEY=
# Any long random string. Bolna sends it on every tool call and webhook.
BOLNA_SECRET=
# Filled in for you after the first sync (stored in the Settings tab); set it to pin an agent.
BOLNA_AGENT_ID=
# The number patients dial, once you have one in Bolna (E.164, e.g. +918035001234).
BOLNA_PHONE_NUMBER=
# plivo or vobiz for Indian numbers bought on Bolna, twilio, exotel...
BOLNA_TELEPHONY_PROVIDER=plivo
BOLNA_LLM_PROVIDER=google
BOLNA_LLM_MODEL=gemini-2.5-flash
BOLNA_TTS_MODEL=bulbul:v3
BOLNA_TTS_VOICE=priya
BOLNA_STT_MODEL=saaras:v4
BOLNA_LANGUAGE=hi
# Push prompt changes to Bolna when doctors, FAQs or the knowledge base change.
BOLNA_AUTO_SYNC=true

# --- Chat agent and call analysis: OpenAI (preferred) or Gemini ----------
# The dashboard's "Try the agent" chat and each call's summary. Phone calls use
# the LLM configured in Bolna (BOLNA_LLM_*) instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# https://aistudio.google.com/apikey . Without it the dashboard chat is rule-based.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Patient messages: WhatsApp, with SMS fallback ------------------------
# Meta WhatsApp Cloud API
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
# An approved template with 4 body variables: name, date+time, doctor, address.
META_WA_TEMPLATE=
META_WA_TEMPLATE_LANG=en
# Twilio (WhatsApp sandbox works for testing: whatsapp:+14155238886)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
# Daily reminders for tomorrow's appointments (clinic time), when the reminder campaign is active.
REMINDER_TIME=18:00

# --- Clinic time zone ------------------------------------------------------
CLINIC_TIMEZONE=Asia/Kolkata
CLINIC_UTC_OFFSET=+05:30
